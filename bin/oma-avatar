#!/usr/bin/env node
import fs from 'node:fs'
import net from 'node:net'
import os from 'node:os'
import path from 'node:path'
import { spawn } from 'node:child_process'
import { fileURLToPath } from 'node:url'
import readline from 'node:readline/promises'

const VERSION = 1
const MAX_SEQUENCE = Number.MAX_SAFE_INTEGER
const MAX_AUDIO_PATH = 512
const MAX_SPEECH_ID = 128
const LOCK_STALE_MS = 10_000
const PROJECT_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const BRIDGE_START_TIMEOUT_MS = 20_000

function fail(message) {
  console.error(`oma-avatar: ${message}`)
  console.error('Run "oma-avatar help" for usage.')
  process.exitCode = 1
}

function runtimeDirectory() {
  const value = process.env.XDG_RUNTIME_DIR
  if (!value) throw new Error('XDG_RUNTIME_DIR is not set; cannot locate the avatar socket')
  if (!path.isAbsolute(value)) throw new Error('XDG_RUNTIME_DIR must be an absolute path')
  return path.join(value, 'oma-avatar')
}

function validateAudioPath(value) {
  if (!value || value.length > MAX_AUDIO_PATH || value.includes('\0')) {
    throw new Error(`audio path must be 1-${MAX_AUDIO_PATH} characters`)
  }
  if (value.startsWith('/') || value.includes('\\')) throw new Error('audio path must be a POSIX-relative path')
  const parts = value.split('/')
  if (parts.some((part) => part === '' || part === '.' || part === '..')) {
    throw new Error('audio path must stay below the runtime audio directory (no ., .., or empty segments)')
  }
  return value
}

function validateSpeechId(value) {
  if (value === undefined) return undefined
  if (!value || value.length > MAX_SPEECH_ID || /[\0\r\n]/u.test(value)) {
    throw new Error(`speech id must be 1-${MAX_SPEECH_ID} characters without newlines`)
  }
  return value
}

function nextSequence(directory) {
  fs.mkdirSync(directory, { recursive: true, mode: 0o700 })
  const sequenceFile = path.join(directory, 'cli-seq')
  const lockFile = `${sequenceFile}.lock`
  let locked = false
  try {
    const deadline = Date.now() + 2_000
    while (!locked) {
      try {
        const descriptor = fs.openSync(lockFile, 'wx', 0o600)
        fs.closeSync(descriptor)
        locked = true
      } catch (error) {
        if (error?.code !== 'EEXIST') throw error
        try {
          if (Date.now() - fs.statSync(lockFile).mtimeMs > LOCK_STALE_MS) fs.unlinkSync(lockFile)
        } catch (statError) {
          if (statError?.code !== 'ENOENT') throw statError
        }
        if (Date.now() >= deadline) throw new Error('timed out waiting for the CLI sequence lock')
        Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 20)
      }
    }
    let previous = 0
    try {
      const text = fs.readFileSync(sequenceFile, 'utf8').trim()
      if (/^[0-9]+$/u.test(text)) previous = Number(text)
      if (!Number.isSafeInteger(previous) || previous < 0) previous = 0
    } catch (error) {
      if (error?.code !== 'ENOENT') throw error
    }
    if (previous >= MAX_SEQUENCE) throw new Error('CLI sequence is exhausted; remove cli-seq only after stopping all senders')
    const next = previous + 1
    const temporary = `${sequenceFile}.${process.pid}.tmp`
    fs.writeFileSync(temporary, `${next}\n`, { encoding: 'utf8', mode: 0o600 })
    fs.renameSync(temporary, sequenceFile)
    return next
  } finally {
    if (locked) {
      try { fs.unlinkSync(lockFile) } catch (error) { if (error?.code !== 'ENOENT') throw error }
    }
  }
}

function usage() {
  console.log(`Usage:
  oma-avatar state|s waiting|thinking|success|error
  oma-avatar emotion|emo neutral|happy|concerned|thinking
  oma-avatar arms balance|normal|stop
  oma-avatar portrait on|off
  oma-avatar eyes auto|center|left|right|up|down|discover
  oma-avatar <command> ... -sec <seconds>
  oma-avatar run <script.ava>
  oma-avatar speech start <relative-audio-file> [speech-id]
  oma-avatar speech stop [speech-id]
  oma-avatar ping
  oma-avatar help`)
}

function makeMessage(args, seq) {
  const [rawCommand, first, second, extra] = args
  const command = rawCommand === 's' ? 'state' : rawCommand === 'emo' ? 'emotion' : rawCommand
  if (command === 'state' && args.length === 2 && ['waiting', 'thinking', 'success', 'error'].includes(first)) {
    return { version: VERSION, seq, type: 'state', state: first }
  }
  if (command === 'emotion' && args.length === 2) {
    const mapped = { neutral: 'waiting', thinking: 'thinking', happy: 'success', concerned: 'error' }[first]
    if (mapped) return { version: VERSION, seq, type: 'state', state: mapped }
  }
  if (command === 'arms' && args.length === 2 && ['balance', 'normal', 'stop'].includes(first)) {
    return { version: VERSION, seq, type: 'arms', placement: first }
  }
  if (command === 'dance' && args.length === 2 && ['swifty', 'stop'].includes(first)) {
    return { version: VERSION, seq, type: 'dance', style: first }
  }
  if (command === 'eyes' && args.length === 2 && ['auto', 'center', 'left', 'right', 'up', 'down', 'discover'].includes(first)) {
    return { version: VERSION, seq, type: 'eyes', direction: first }
  }
  if (command === 'speech' && first === 'start' && (args.length === 3 || args.length === 4) && second) {
    const speechId = args.length === 4 ? validateSpeechId(extra) : undefined
    return { version: VERSION, seq, type: 'speech.start', audioPath: validateAudioPath(second), ...(speechId ? { speechId } : {}) }
  }
  if (command === 'speech' && first === 'stop' && (args.length === 2 || args.length === 3)) {
    return { version: VERSION, seq, type: 'speech.stop', ...(args.length === 3 ? { speechId: validateSpeechId(second) } : {}) }
  }
  if (command === 'portrait' && args.length === 2 && ['on', 'off'].includes(first)) {
    return { version: VERSION, seq, type: 'diagnostics', level: 'info', code: 'portrait', message: first }
  }
  throw new Error('invalid arguments')
}
function splitDuration(args) {
  if (args.length < 2 || args.at(-2) !== '-sec') return { commandArgs: args, seconds: 0 }
  const seconds = Number(args.at(-1))
  if (!Number.isFinite(seconds) || seconds < 0 || seconds > 3_600) {
    throw new Error('duration must be a number of seconds from 0 to 3600')
  }
  return { commandArgs: args.slice(0, -2), seconds }
}

async function sendCommand(args, directory) {
  const { commandArgs, seconds } = splitDuration(args)
  const message = makeMessage(commandArgs, nextSequence(directory))
  await sendWithAutoStart(directory, message)
  if (seconds > 0) {
    await new Promise((resolve) => setTimeout(resolve, seconds * 1_000))
    if (message.type === 'dance' && message.style === 'swifty') {
      await sendWithAutoStart(directory, makeMessage(['dance', 'stop'], nextSequence(directory)))
    }
  }
}


function send(directory, message) {
  const socketPath = path.join(directory, 'bridge.sock')
  return new Promise((resolve, reject) => {
    const socket = net.createConnection(socketPath)
    let settled = false
    const finish = (error) => {
      if (settled) return
      settled = true
      if (error) reject(error)
      else resolve()
    }
    socket.setTimeout(2_000, () => finish(new Error('timed out connecting to the avatar')))
    socket.once('connect', () => { socket.end(`${JSON.stringify(message)}\n`, () => finish()) })
    socket.once('error', (error) => finish(error))
    socket.once('close', () => { if (!settled) finish(new Error('avatar socket closed before accepting the message')) })
  })
}
function bridgeReady(directory) {
  const socketPath = path.join(directory, 'bridge.sock')
  return new Promise((resolve) => {
    const socket = net.createConnection(socketPath)
    const finish = (ready) => {
      socket.destroy()
      resolve(ready)
    }
    socket.setTimeout(500, () => finish(false))
    socket.once('connect', () => finish(true))
    socket.once('error', () => finish(false))
  })
}

async function startBridge(directory) {
  const socketPath = path.join(directory, 'bridge.sock')
  if (await bridgeReady(directory)) return
  try {
    fs.unlinkSync(socketPath)
  } catch (error) {
    if (error?.code !== 'ENOENT') throw error
  }
  const child = spawn('mise', ['exec', 'rust@1.98.1', '--', 'npm', 'run', 'tauri:dev'], {
    cwd: PROJECT_ROOT,
    detached: true,
    stdio: 'ignore',
  })
  child.unref()
  const deadline = Date.now() + BRIDGE_START_TIMEOUT_MS
  while (Date.now() < deadline) {
    if (await bridgeReady(directory)) return
    await new Promise((resolve) => setTimeout(resolve, 250))
  }
  throw new Error('timed out starting the avatar bridge')
}

async function sendWithAutoStart(directory, message) {
  try {
    await send(directory, message)
  } catch (error) {
    if (process.env.OMA_AVATAR_NO_AUTO_START === '1' || !['ENOENT', 'ECONNREFUSED'].includes(error?.code)) throw error
    await startBridge(directory)
    await send(directory, message)
  }
}
async function executeScript(file, directory) {
  if (!file || !file.endsWith('.ava')) throw new Error('script file must use the .ava extension')
  const input = readline.createInterface({ input: process.stdin, output: process.stdout })
  const inputIterator = input[Symbol.asyncIterator]()
  try {
    const lines = fs.readFileSync(path.resolve(process.cwd(), file), 'utf8').split(/\r?\n/u)
    for (const [index, rawLine] of lines.entries()) {
      const line = rawLine.trim()
      if (!line || line.startsWith('#')) continue
      const parts = line.split(/\s+/u)
      const [command, value] = parts
      console.log(`ava> ${line}`)
      if (command === 'sleep') {
        const seconds = Number(value)
        if (parts.length !== 2 || !Number.isFinite(seconds) || seconds < 0 || seconds > 3_600) {
          throw new Error(`script line ${index + 1}: sleep requires seconds from 0 to 3600`)
        }
        await new Promise((resolve) => setTimeout(resolve, seconds * 1_000))
        continue
      }
      if (command === 'enter') {
        const prompt = parts.slice(1).join(' ') || 'Press Enter to continue'
        process.stdout.write(`${prompt} `)
        const result = await inputIterator.next()
        if (result.done) throw new Error(`script line ${index + 1}: input closed while waiting for Enter`)
        continue
      }
      await sendCommand(parts, directory)
    }
  } finally {
    input.close()
  }
}

const args = process.argv.slice(2)
if (args.length === 0 || args[0] === 'help') {
  usage()
} else {
  try {
    const directory = runtimeDirectory()
    if (args[0] === 'run') {
      if (args.length !== 2) throw new Error('run requires one .ava script file')
      await executeScript(args[1], directory)
    } else {
      await sendCommand(args, directory)
    }
  } catch (error) {
    const code = error?.code
    if (code === 'ENOENT' || code === 'ECONNREFUSED') fail('avatar is not running (bridge socket is unavailable)')
    else if (code === 'EACCES') fail('permission denied accessing the avatar runtime directory or socket')
    else fail(error instanceof Error ? error.message : String(error))
  }
}
